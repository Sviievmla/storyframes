# PayPal Configuration
# Get these from https://developer.paypal.com/dashboard/applications/live

# PayPal Environment: 'sandbox' for testing, 'live' for production
PAYPAL_MODE=sandbox

# PayPal Client ID (from your PayPal App)
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# PayPal Client Secret (from your PayPal App) - KEEP THIS SECRET!
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Server Configuration
PORT=3000

# CORS Configuration - Set to your frontend URL in production
# For local development: http://localhost:8080 or http://127.0.0.1:8080
# For production: https://mystoryframes.shop
FRONTEND_URL=https://mystoryframes.shop
