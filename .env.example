# PayPal Configuration
# Get your credentials from: https://developer.paypal.com/dashboard/

# For sandbox testing:
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# For production (when ready to go live):
# PAYPAL_CLIENT_ID=your_live_client_id_here
# PAYPAL_CLIENT_SECRET=your_live_client_secret_here
# PAYPAL_API_BASE=https://api-m.paypal.com

# Server Configuration
PORT=3000

# Email Configuration (for order notifications)
# Using Gmail SMTP as example - configure based on your email provider
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Story Frames <noreply@storyframes.com>
EMAIL_TO=Sviievmla@gmail.com
