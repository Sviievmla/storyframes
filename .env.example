# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=10000

# ===========================================
# PAYPAL CONFIGURATION (LIVE/PRODUCTION)
# ===========================================
# Get your credentials from: https://developer.paypal.com/dashboard/
# IMPORTANT: Use LIVE credentials for production, not sandbox

# For LIVE/Production (REQUIRED):
PAYPAL_CLIENT_ID=your_live_client_id_here
PAYPAL_CLIENT_SECRET=your_live_client_secret_here
PAYPAL_API_BASE=https://api-m.paypal.com

# PayPal Webhook ID (for webhook signature verification)
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# For sandbox/testing (development only):
# PAYPAL_CLIENT_ID=your_sandbox_client_id_here
# PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
# Render automatically provides DATABASE_URL
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:5432/database

# Database connection pool size (default: 10)
# Free tier: Keep at 5-10 to avoid connection limits
# Paid tier: Can increase to 20+ based on plan
DB_POOL_SIZE=10

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
# Choose one: Gmail, SendGrid, Mailgun, or custom SMTP

# Gmail SMTP (App Password required):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# SendGrid SMTP:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key

# Mailgun SMTP:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=your_mailgun_smtp_user
# SMTP_PASSWORD=your_mailgun_smtp_password

# Email addresses:
EMAIL_FROM=noreply@mystoryframes.shop
ADMIN_EMAIL=Sviievmla@gmail.com

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
FRONTEND_URL=https://mystoryframes.shop

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# SECURITY (Optional but recommended)
# ===========================================
# Add if you want additional security headers
# CORS_ORIGIN=https://mystoryframes.shop
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
